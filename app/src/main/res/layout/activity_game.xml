<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#606060">

    <View
        android:id="@+id/topRoad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A0A0A0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/middleLine"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@id/finishLine" />

    <View
        android:id="@+id/middleLine"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@id/finishLine" />

    <View
        android:id="@+id/bottomRoad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#909090"
        app:layout_constraintTop_toBottomOf="@id/middleLine"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@id/finishLine" />

    <View
        android:id="@+id/finishLine"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Красная машина -->
    <ImageView
        android:id="@+id/redCar"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:src="@drawable/car_red"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/topRoad"
        app:layout_constraintBottom_toBottomOf="@id/topRoad"
        app:layout_constraintLeft_toLeftOf="@id/topRoad" />

    <!-- Розовая машина -->
    <ImageView
        android:id="@+id/pinkCar"
        android:layout_width="120dp"
        android:layout_height="60dp"
        android:src="@drawable/car_pink"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/bottomRoad"
        app:layout_constraintBottom_toBottomOf="@id/bottomRoad"
        app:layout_constraintLeft_toLeftOf="@id/bottomRoad" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:paddingTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Кнопка ЕХАТЬ (для красной машины) -->
    <Button
        android:id="@+id/btnDrive1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ЕХАТЬ"
        android:onClick="Drive1"
        android:backgroundTint="#F44336"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/btnStart" />

    <!-- старт, пауза, заново кнопки -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="СТАРТ"
        android:onClick="Start"
        android:backgroundTint="#00C853"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/btnDrive1"
        app:layout_constraintRight_toLeftOf="@id/btnDrive2" />

    <!-- Кнопка ЕХАТЬ (для розовой машины) -->
    <Button
        android:id="@+id/btnDrive2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ЕХАТЬ"
        android:onClick="Drive2"
        android:backgroundTint="#E91E63"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/btnStart"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>